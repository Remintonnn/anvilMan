/*====== The Test Zone Above ======*/



QFrame {
    background-color: #222222;
    border-radius:8px;
    border: 2px solid #b87700;
}QFrame:disabled {
    background-color: #151515;
    border-radius:8px;
    border: 2px solid #454545;
}

QWidget {
    selection-background-color: #878787;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #111115;
}

QMenuBar {
    background-color: rgb(60, 35, 0);
    color: white;
}

QTableView {
    background-color: #202020;
    alternate-background-color: #3b1500;
    border-radius: 0px;
    border: 2px solid #676767;
    gridline-color: #454545;
    color: #FFFFFF;
}QTableView::item:hover {
    background-color: #333333;
}QTableView::item:selected:active {
    background-color: #878787;
    color: white;
}QHeaderView{
	border:none;
}QHeaderView::section {
	background-color: #333333;
	color: #FFFFFF;
	border:none;
    border-right: 1px solid #676767;
	font: 10pt &quot;OCR A Extended&quot;;
	font-weight: bold;
}

QTableView:disabled {
    border: 2px solid #333333;
	border-radius: 0px;
}QHeaderView:disabled{
	border:none;
}QHeaderView::section:disabled {
	color: #454545;
	background-color: #202020;
	border:none;
    border-right: 1px solid #333333;
	font: 10pt &quot;OCR A Extended&quot;;
	font-weight: bold;
}

QScrollBar:vertical {
    background-color: #222222;
    width: 19px;
    margin: 19px 1px 19px 1px;
}QScrollBar::handle:vertical {
    background-color: #454545;
    min-height: 20px;
    border-radius: 0px;
}QScrollBar::handle:hover {background-color: #777777;}
QScrollBar::add-line, QScrollBar::sub-line{/* Arrow Things */
    background-color: #303030;
    height: 13px;
    subcontrol-origin: margin;
	border: 2px solid #676767;
 	margin: 1px 1px 1px 1px;
}QScrollBar::add-line:hover, QScrollBar::sub-line:hover{background-color: #555555;}
QScrollBar::up-arrow:vertical {image: url(:/UI/upArrow.png);}
QScrollBar::down-arrow:vertical {image: url(:/UI/downArrow.png);}

QScrollBar[grayOut=true]::handle:vertical {
    background-color: #252525;
}QScrollBar[grayOut=true]::add-line:disabled, QScrollBar[grayOut=true]::sub-line{/* Arrow Things */
	border: 2px solid #333333;
	background-color: #222222
}QScrollBar[grayOut=true]::up-arrow:vertical {image: url(:/NOTATHING);}
QScrollBar[grayOut=true]::down-arrow:vertical {image: url(:/NOTATHING);}

/*====== Smol things ======*/

QLabel {
	color: #ffffff;
    border-radius: 8px;
    border: 2px solid #505050;
}QLabel:disabled{
	color: #454545;
	border: 2px solid #333333;
}

QPlainTextEdit{
	border-radius: 0px;
	border: 2px solid #676767;
	color: #FFFFFF;
}
QPlainTextEdit:disabled{
	border: 2px solid #181818;
	color: #676767;
}

QPushButton {
    background-color: #222222;
    color: #FFFFFF;
    border-radius: 4px;
	border: 2px solid #505050;
}QPushButton:hover {
	background-color: #565656;
	border: 2px solid #878787;
}QPushButton:disabled{
	border: 2px solid #181818;
	color: #676767;
}

QPushButton[chosenOne=True]{
    background-color: #454545;
    color: #FFFFFF;
    border-radius: 0px;
	border: 2px solid #E87700;
}QPushButton[chosenOne=True]:hover {
	background-color: #5656FF;
	border: 2px solid #878787;
}

QCheckBox{
    spacing: 6px;
    font-size: 12px;
    color: #CCCCCC;
}QCheckBox:hover{color: #FFFFFF;}QCheckBox::indicator{
    width: 12px;
    height: 12px;
    border: 2px solid #676767;
    border-radius: 0px;
}QCheckBox::indicator:checked{
	image: url(:/UI/checked10x10Center.png)
}

QCheckBox:disabled{
    spacing: 6px;
    font-size: 12px;
    color: #333333;
}
QCheckBox::indicator:disabled{
    width: 12px;
    height: 12px;
    border: 2px solid #333333;
    border-radius: 0px;
}QCheckBox::indicator:checked:disabled{
	image: url(:/UI/checked10x10CenterGrayout.png)
}


QToolTip {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #676767;
    border-radius: 6px;
    padding: 5px;
    font-size: 12px;
}</string>
